# Server
NODE_ENV=development
PORT=5000

# MongoDB (optional — omit to run without a database)
# MONGODB_URI=mongodb://127.0.0.1:27017/ai-codebase-intelligence

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173

# API
API_PREFIX=/api/v1

# Repository clones (optional — defaults to OS temp dir if unset or empty)
# REPOS_CLONE_DIR=C:\path\to\repos

# File tree limits for POST /repositories/analyze
# FILE_TREE_MAX_DEPTH=8
# FILE_TREE_MAX_NODES=2000

# Dependency graph limits for POST /repositories/analyze
# DEPENDENCY_GRAPH_MAX_NODES=500
# DEPENDENCY_GRAPH_MAX_EDGES=2000
