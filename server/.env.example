# Server
NODE_ENV=development
PORT=5000

# MongoDB (optional — omit to run without a database)
# MONGODB_URI=mongodb://127.0.0.1:27017/ai-codebase-intelligence

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173

# API
API_PREFIX=/api/v1

# Repository ingestion (cloned repos land here)
REPOS_CLONE_DIR=
